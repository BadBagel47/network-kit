// Demo deployment of network-kit's example games (examples/demo).
// Games deploy their own Worker with their own copy of network-kit (docs/INTEGRATION.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "network-kit-demo",
  "main": "examples/demo/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "examples/demo/public" },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "TURNS", "class_name": "TurnRoom" },
      { "name": "QUIZ", "class_name": "QuizRoom" },
      { "name": "DIAG", "class_name": "DiagStore" }
    ]
  },
  // Free plan: SQLite-backed Durable Objects only.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "TurnRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["QuizRoom"] },
    { "tag": "v3", "new_sqlite_classes": ["DiagStore"] }
  ],
  // The admin page decides whether the demo is open (F-003, F-004).
  "services": [{ "binding": "NETWORK_KIT_ADMIN", "service": "network-kit-admin", "entrypoint": "GameApi" }],
  "vars": { "ROOM_JURISDICTION": "eu" },
  // Logs for the public demo (F-026), a tenth of the requests.
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
