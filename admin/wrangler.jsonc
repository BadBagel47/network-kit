// network-kit admin page (F-008): usage per game against the Free plan limits.
// Deployed by .github/workflows/deploy-admin.yml; secrets ADMIN_PASSWORD and
// CF_ANALYTICS_TOKEN are set there from the repository's secrets.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "network-kit-admin",
  "main": "entry.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [
      { "name": "GUARD", "class_name": "AdminGuard" },
      { "name": "STORE", "class_name": "AdminStore" }
    ]
  },
  // Free plan: SQLite-backed Durable Objects only.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AdminGuard"] },
    { "tag": "v2", "new_sqlite_classes": ["AdminStore"] }
  ],
  "observability": { "enabled": true }
}
